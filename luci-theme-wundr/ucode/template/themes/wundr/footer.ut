{# Wundr theme — LuCI footer template (OpenWrt 23.05 / 24.x / 25.x ucode) #}
  {% if (!blank_page): %}
    </main>
  </div>

  <aside class="wb-pro-drawer" id="wb-pro-drawer" aria-hidden="true" hidden>
    <div class="wb-pro-drawer-header">
      <div>
        <h3>{{ _('Advanced') }}</h3>
        <div class="wb-sub">{{ _('Every native LuCI page, unchanged.') }}</div>
      </div>
      <button class="wb-icon-btn" id="wb-pro-drawer-close" type="button" aria-label="{{ _('Close advanced navigation') }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="wb-pro-drawer-content" id="wb-pro-drawer-menu"></div>
  </aside>
  <div class="wb-pro-backdrop" id="wb-pro-backdrop" hidden></div>

  <footer class="wb-footer">
    <div class="wb-footer-brand">
      <span class="wb-footer-brand-name"><svg class="wb-logo wb-logo-small" viewBox="0 0 40 44" aria-hidden="true"><path class="wb-logo-wave" d="M6 12a19 19 0 0 1 28 0"/><path class="wb-logo-wave wb-logo-wave-2" d="M11 18a12 12 0 0 1 18 0"/><path class="wb-logo-frame" d="M16 24a5.5 5.5 0 0 1 8 0"/><path class="wb-logo-path" d="M9 26l4 11 7-14 7 14 4-11"/></svg>Wundr</span>
      <span class="wb-footer-sub">{{ version.distname }} {{ version.distversion }} · LuCI {{ version.luciversion }} · <a class="wb-footer-credit" href="https://github.com/wundr-router/wundr" target="_blank" rel="noreferrer">Powered by Wundr</a></span>
    </div>
    <div class="wb-footer-right">
      <a href="{{ dispatcher.build_url('admin/system/reboot') }}">{{ _('Reboot') }}</a>
      <span class="sep">·</span>
      <a href="{{ dispatcher.build_url('admin/logout') }}">{{ _('Sign out') }}</a>
    </div>
  </footer>

  <script src="{{ media }}/shell.js?v=0.2.0"></script>
  <script>L.require('menu-wundr')</script>
  {% endif %}
</body>
</html>
