{
	"luci-app-wundr": {
		"description": "Wundr screens — read router state and drive native UCI writers",
		"read": {
			"ubus": {
				"wundr": [ "diagnostic" ],
				"luci-rpc": [ "getHostHints", "getDHCPLeases", "getNetworkDevices", "getWirelessDevices", "getBoardJSON" ],
				"luci": [ "getTimezones", "getRealtimeStats" ],
				"system": [ "board", "info" ],
				"network": [ "get_proto_handlers" ],
				"network.interface": [ "dump" ],
				"network.device": [ "status" ],
				"network.wireless": [ "status" ],
				"iwinfo": [ "info", "assoclist", "freqlist", "txpwrlist", "countrylist" ],
				"rc": [ "list" ],
				"log": [ "read" ]
			},
			"uci": [ "wundr", "network", "wireless", "dhcp", "firewall", "system", "luci", "sqm" ]
		},
		"write": {
			"uci": [ "wundr", "network", "wireless", "dhcp", "firewall", "system", "sqm" ],
			"ubus": { "rc": [ "init" ] }
		}
	}
}
